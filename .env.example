# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token

# OpenAI API Key (used for GPT-4o Vision & GPT-4o-mini text/follow-ups)
OPENAI_API_KEY=your_openai_api_key

# Numeric Telegram User ID of the bot administrator (/admin, /stats, unlimited scans)
ADMIN_ID=123456789

# Optional model overrides (defaults shown below)
# OPENAI_MODEL=gpt-4o
# OPENAI_MINI_MODEL=gpt-4o-mini
